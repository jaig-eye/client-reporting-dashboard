# Supabase
# supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key   # browser client
SUPABASE_SECRET_KEY=your-secret-key               # server only — never exposed to browser

# Google Ads API
# console.cloud.google.com → Enable Google Ads API → OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_MCC_CUSTOMER_ID=   # digits only, no dashes

# Meta Marketing API
# developers.facebook.com → Business App → Marketing API
META_APP_ID=
META_APP_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: set to https://dash.golaunchlocal.com in Vercel environment variables

# Admin panel password (you set this, share with your team)
# Used for super-admin login (with an emailed OTP). NOT the session cookie value —
# it was, until signed sessions landed, which is why it must be rotated once.
ADMIN_PASSWORD=choose-a-strong-password

# REQUIRED IN PRODUCTION. HMAC key for admin session tokens.
#   openssl rand -hex 32
# There is deliberately NO fallback in production: ADMIN_PASSWORD used to be the
# literal admin_session cookie value sent on every request, so it may sit in
# request logs, WAF logs, HAR exports and screenshots. Signing with it would let
# anyone holding an old cookie forge a super-admin session, bypassing both the
# password and the OTP. With this unset, production cannot mint or verify a
# session and nobody can log in — set it BEFORE deploying.
SESSION_SECRET=generate-a-random-string

# Cron job protection. With this unset, every cron route now refuses all requests
# (it used to accept the literal header "Bearer undefined").
CRON_SECRET=generate-a-random-string

# Ingest endpoint shared secret
# Used by the Google Ads MCC Script and Meta webhook to authenticate POSTs to
# /api/ingest/google and /api/ingest/meta. Generate with: openssl rand -hex 32
INGEST_SECRET=generate-a-random-string

# Ad Fuel public API key — used by the GHL sidebar widget (x-api-key header)
# Generate with: openssl rand -hex 32
ADFUEL_API_KEY=generate-a-random-string

# MCP dashboard server — authenticates Claude Code's /api/mcp endpoint
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')" | Write-Output
# Set DASHBOARD_MCP_URL in production to your Vercel deployment URL (defaults to localhost:3000)
DASHBOARD_MCP_SECRET=generate-a-random-string
DASHBOARD_MCP_URL=https://your-dashboard.vercel.app

# Email (Mailgun SMTP)
# mailgun.com → Sending → Domains → your domain → SMTP credentials
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USER=postmaster@mg.yourdomain.com
MAILGUN_SMTP_PASS=your-mailgun-smtp-password
MAILGUN_FROM=Agency Name <noreply@mg.yourdomain.com>
